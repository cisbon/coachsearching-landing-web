# Database Configuration
DB_HOST=localhost
DB_NAME=coachsearching
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://coachsearching.com
API_URL=https://clouedo.com/coachsearching/api

# Security
JWT_SECRET=change_this_to_a_random_64_character_string_in_production
SESSION_LIFETIME=7200
CORS_ALLOWED_ORIGINS=https://coachsearching.com,https://www.coachsearching.com

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@coachsearching.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@coachsearching.com
SMTP_FROM_NAME=CoachSearching

# Payment Configuration (Stripe example)
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
PLATFORM_FEE_PERCENTAGE=15

# File Upload
UPLOAD_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
UPLOAD_PATH=../uploads
